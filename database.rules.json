{
  "rules": {
    "admins": {
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        ".write": "auth != null && auth.uid === $ownerUid",

        "areas": {
          "$area": {
            "subjects": {
              "$personId": {
                ".read": "auth != null && (auth.uid === $ownerUid || (root.child('empleados/' + auth.uid + '/adminAsignado').val() === $ownerUid && root.child('empleados/' + auth.uid + '/areaAsignada').val() === $area))",
                ".write": "auth != null && auth.uid === $ownerUid",

                "planillas": {
                  "$type": {
                    "$recordId": {
                      ".read": "auth != null && (auth.uid === $ownerUid || (root.child('empleados/' + auth.uid + '/adminAsignado').val() === $ownerUid && root.child('empleados/' + auth.uid + '/areaAsignada').val() === $area))",

                      ".write": "auth != null && newData.exists() && ((!data.exists() && newData.hasChildren(['createdAt','createdBy']) && newData.child('createdBy').val() === auth.uid && (auth.uid === $ownerUid || (root.child('empleados/' + auth.uid + '/adminAsignado').val() === $ownerUid && root.child('empleados/' + auth.uid + '/areaAsignada').val() === $area))) || (data.exists() && data.child('createdBy').val() === auth.uid && newData.child('createdBy').val() === data.child('createdBy').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",

                      ".validate": "newData.exists() && newData.hasChildren(['createdAt','createdBy']) && newData.child('createdBy').val() === auth.uid",

                      "createdAt": {
                        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$/) && (!data.exists() || newData.val() === data.val())"
                      },

                      "createdBy": {
                        ".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || newData.val() === data.val())"
                      },

                      "$other": {
                        ".validate": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    "empleados": {
      "$employeeUid": {
        ".read": "auth != null && (auth.uid === $employeeUid || root.child('admins/' + auth.uid).exists())",
        ".write": "auth != null && root.child('admins/' + auth.uid).exists()"
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
